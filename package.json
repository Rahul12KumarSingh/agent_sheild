{
  "name": "agentshield-hooks",
  "version": "0.12.0",
  "description": "A policy checkpoint for AI coding agents: checks every prompt and action, blocks the dangerous ones, suggests safe alternatives.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rahul12KumarSingh/agent_sheild.git"
  },
  "homepage": "https://agentshield-r3nhtbb77q-as.a.run.app",
  "keywords": [
    "claude-code",
    "copilot",
    "ai-agents",
    "prompt-injection",
    "security",
    "hooks",
    "guardrails"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/cli.js",
    "dist/server.js",
    "dist/console",
    "policies",
    "scenarios",
    "README.md"
  ],
  "bin": {
    "agentshield": "dist/cli.js",
    "agentshield-hooks": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup && vite build --config console/vite.config.ts --logLevel warn && node scripts/build-plugin.mjs",
    "build:server": "tsup",
    "dev:server": "tsup --watch --onSuccess \"node dist/server.js\"",
    "dev:console": "vite --config console/vite.config.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p console",
    "record": "node scripts/record.mjs",
    "bench": "node scripts/bench-hook.mjs",
    "eval": "node scripts/eval.mjs",
    "smoke": "node scripts/smoke.mjs",
    "deploy": "node scripts/deploy.mjs",
    "rollback": "node scripts/rollback.mjs",
    "attacker": "node scripts/fake-attacker.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "yaml": "^2.9.1"
  }
}
