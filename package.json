{
  "name": "agentshield",
  "version": "0.0.1",
  "description": "A policy checkpoint for AI coding agents: checks every prompt and action, blocks the dangerous ones, suggests safe alternatives.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "agentshield": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "dev:server": "tsup --watch --onSuccess \"node dist/server.js\"",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
